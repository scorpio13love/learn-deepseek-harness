<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0"><head><title>DSH 运行时知识图谱</title></head><body>
  <outline text="DSH 运行时知识图谱">
    <outline text="控制平面">
      <outline text="turn / step / request">
      </outline>
      <outline text="cancel 是协作式">
      </outline>
      <outline text="请求从日志派生">
      </outline>
      <outline text="失败与恢复分离">
      </outline>
    </outline>
    <outline text="事实与上下文">
      <outline text="append-only session log">
      </outline>
      <outline text="surface 是视图">
      </outline>
      <outline text="replace 不删历史">
      </outline>
      <outline text="compaction 是工作集">
      </outline>
    </outline>
    <outline text="工具与权限">
      <outline text="模型面 / 执行面 / 投影面">
      </outline>
      <outline text="guard 只能收紧">
      </outline>
      <outline text="approval fail closed">
      </outline>
      <outline text="并发默认独占">
      </outline>
    </outline>
    <outline text="组合与生命周期">
      <outline text="Context / inject">
      </outline>
      <outline text="Fiber / effect">
      </outline>
      <outline text="Bundle / Profile / Patch">
      </outline>
      <outline text="Definition–Provider–Consumer">
      </outline>
    </outline>
    <outline text="执行边界">
      <outline text="fs / shell / sandbox">
      </outline>
      <outline text="MCP 外部工具">
      </outline>
      <outline text="browser / CUA">
      </outline>
      <outline text="subagent 预算">
      </outline>
    </outline>
    <outline text="质量与宿主">
      <outline text="projection / SSE">
      </outline>
      <outline text="record / replay">
      </outline>
      <outline text="snapshot / eval">
      </outline>
      <outline text="Web / SDK / UI">
      </outline>
    </outline>
  </outline>

  <outline text="s01 · 最小 agent loop">
    <outline text="turn / step">
      <outline text="turn/start → turn/end">
      </outline>
      <outline text="step = 一次模型请求">
      </outline>
      <outline text="turn/end 放 finally">
      </outline>
    </outline>
    <outline text="流式组装">
      <outline text="SSE chunk">
      </outline>
      <outline text="block index">
      </outline>
      <outline text="StreamAssembler">
      </outline>
    </outline>
    <outline text="取消">
      <outline text="协作式 AbortSignal">
      </outline>
      <outline text="已交付前缀保留">
      </outline>
      <outline text="assistant/attempt">
      </outline>
    </outline>
    <outline text="日志">
      <outline text="deriveMessages()">
      </outline>
      <outline text="surface = 模型视图">
      </outline>
      <outline text="拒绝隐藏 messages 数组">
      </outline>
    </outline>
  </outline>
  <outline text="s02 · 工具往返">
    <outline text="调用">
      <outline text="assistant tool-call">
      </outline>
      <outline text="参数是原始 JSON 字符串">
      </outline>
      <outline text="模型不执行工具">
      </outline>
    </outline>
    <outline text="执行">
      <outline text="ToolRegistry">
      </outline>
      <outline text="tool/call 事件">
      </outline>
      <outline text="结果规范化">
      </outline>
    </outline>
    <outline text="结果">
      <outline text="tool/result 回到 surface">
      </outline>
      <outline text="toolCallId 配对">
      </outline>
      <outline text="isError 也是结果">
      </outline>
    </outline>
    <outline text="下一步">
      <outline text="deriveMessages 带结果">
      </outline>
      <outline text="turn/step 归属">
      </outline>
      <outline text="失败不终止 turn">
      </outline>
    </outline>
  </outline>
  <outline text="s03 · Session Log">
    <outline text="事实">
      <outline text="append-only events">
      </outline>
      <outline text="seq 连续递增">
      </outline>
      <outline text="事件不可原地修改">
      </outline>
    </outline>
    <outline text="surface">
      <outline text="当前模型视图">
      </outline>
      <outline text="deriveMessages()">
      </outline>
      <outline text="append / replace">
      </outline>
    </outline>
    <outline text="replace">
      <outline text="摘要遮蔽旧视图">
      </outline>
      <outline text="sourceEventSeqs">
      </outline>
      <outline text="原始事件保留">
      </outline>
    </outline>
    <outline text="恢复">
      <outline text="Session.restore()">
      </outline>
      <outline text="重放">
      </outline>
      <outline text="fork 前缀">
      </outline>
    </outline>
  </outline>
  <outline text="s04 · 流式与 attempt">
    <outline text="chunk">
      <outline text="text/reasoning/tool delta">
      </outline>
      <outline text="按 block index 归位">
      </outline>
      <outline text="live 帧先给 UI">
      </outline>
    </outline>
    <outline text="组装">
      <outline text="block-start / delta / end">
      </outline>
      <outline text="完整 assistant/message">
      </outline>
      <outline text="stream 一并持久化">
      </outline>
    </outline>
    <outline text="attempt">
      <outline text="失败/取消也结算">
      </outline>
      <outline text="保留已交付前缀">
      </outline>
      <outline text="不进模型历史">
      </outline>
    </outline>
    <outline text="usage / 重放">
      <outline text="usage 在 finish 前">
      </outline>
      <outline text="取消可解释">
      </outline>
      <outline text="stream 可回放">
      </outline>
    </outline>
  </outline>
  <outline text="s05 · 工具契约">
    <outline text="作者 DSL">
      <outline text="TypeScript 参数">
      </outline>
      <outline text="编译成 JSON Schema">
      </outline>
      <outline text="模型只看 schema">
      </outline>
    </outline>
    <outline text="参数校验">
      <outline text="validateParameters">
      </outline>
      <outline text="执行前拒绝">
      </outline>
      <outline text="isError 给模型看">
      </outline>
    </outline>
    <outline text="输出契约">
      <outline text="规范值">
      </outline>
      <outline text="output.schema">
      </outline>
      <outline text="render 投影">
      </outline>
    </outline>
    <outline text="作用域">
      <outline text="scoped 工具">
      </outline>
      <outline text="conditions">
      </outline>
      <outline text="restrictions">
      </outline>
    </outline>
  </outline>
  <outline text="s06 · 工具运行时">
    <outline text="前置闸门">
      <outline text="pre-execute">
      </outline>
      <outline text="单调 guard 只能收紧">
      </outline>
      <outline text="ask / deny / allow">
      </outline>
    </outline>
    <outline text="审批">
      <outline text="approval/request">
      </outline>
      <outline text="绑定参数与调用者">
      </outline>
      <outline text="fail closed">
      </outline>
    </outline>
    <outline text="执行">
      <outline text="tools/execute">
      </outline>
      <outline text="显式并发声明">
      </outline>
      <outline text="exclusive batch">
      </outline>
    </outline>
    <outline text="结果">
      <outline text="post-execute">
      </outline>
      <outline text="finalizeContent">
      </outline>
      <outline text="tools/result 只读">
      </outline>
    </outline>
  </outline>
  <outline text="s07 · 系统提示词">
    <outline text="sections">
      <outline text="name / order / text">
      </outline>
      <outline text="稳定前缀">
      </outline>
      <outline text="KV cache">
      </outline>
    </outline>
    <outline text="动态上下文">
      <outline text="variables">
      </outline>
      <outline text="contexts">
      </outline>
      <outline text="toolOrder">
      </outline>
    </outline>
    <outline text="准入">
      <outline text="head admission">
      </outline>
      <outline text="system head 替换/追加">
      </outline>
      <outline text="in-history">
      </outline>
    </outline>
    <outline text="泄露风险">
      <outline text="不要塞临时秘密">
      </outline>
      <outline text="renderContextMessage">
      </outline>
      <outline text="可重放">
      </outline>
    </outline>
  </outline>
  <outline text="s08 · Inbox / steering">
    <outline text="两条队列">
      <outline text="next-turn">
      </outline>
      <outline text="next-step">
      </outline>
      <outline text="claim 是纯删除">
      </outline>
    </outline>
    <outline text="三种输入">
      <outline text="followup 唤醒">
      </outline>
      <outline text="steer 改变当前路径">
      </outline>
      <outline text="inject 不唤醒">
      </outline>
    </outline>
    <outline text="边界">
      <outline text="turn 边界领取全部 next-step">
      </outline>
      <outline text="step 边界只领 next-step">
      </outline>
      <outline text="step/end 之后进入历史">
      </outline>
    </outline>
    <outline text="取消">
      <outline text="keepInbox">
      </outline>
      <outline text="取消不是删除">
      </outline>
      <outline text="whenIdle 跨轮次">
      </outline>
    </outline>
  </outline>
  <outline text="s09 · LLM seam">
    <outline text="统一词汇">
      <outline text="Message / ContentBlock">
      </outline>
      <outline text="StreamChunk">
      </outline>
      <outline text="loop 不出现 provider 分支">
      </outline>
    </outline>
    <outline text="prepareCall">
      <outline text="绑定 config">
      </outline>
      <outline text="capabilities">
      </outline>
      <outline text="retryPolicy">
      </outline>
    </outline>
    <outline text="Messages">
      <outline text="/v1/messages">
      </outline>
      <outline text="tool_use / tool_result">
      </outline>
      <outline text="thinking / usage">
      </outline>
    </outline>
    <outline text="失败与重试">
      <outline text="失败事实归一化">
      </outline>
      <outline text="step 内重试">
      </outline>
      <outline text="不重跑 pre-step">
      </outline>
    </outline>
  </outline>
  <outline text="s10 · JSONL 持久化">
    <outline text="写入">
      <outline text="append 到 buffer">
      </outline>
      <outline text="flush + fsync">
      </outline>
      <outline text="显式持久屏障">
      </outline>
    </outline>
    <outline text="文件">
      <outline text="session.jsonl">
      </outline>
      <outline text="一行一个事件">
      </outline>
      <outline text="不压缩/不校验和">
      </outline>
    </outline>
    <outline text="修复">
      <outline text="torn tail">
      </outline>
      <outline text="丢弃无效后缀">
      </outline>
      <outline text="未闭合 turn 补 interrupted">
      </outline>
    </outline>
    <outline text="fork">
      <outline text="复制前缀">
      </outline>
      <outline text="forked closer">
      </outline>
      <outline text="session/end-seed">
      </outline>
    </outline>
  </outline>
  <outline text="s11 · Compaction">
    <outline text="触发">
      <outline text="token estimate">
      </outline>
      <outline text="thresholdRatio">
      </outline>
      <outline text="beforeStep / overflow">
      </outline>
    </outline>
    <outline text="prune">
      <outline text="超长 tool/result">
      </outline>
      <outline text="语义损失小">
      </outline>
      <outline text="先裁剪再摘要">
      </outline>
    </outline>
    <outline text="summary">
      <outline text="独立模型请求">
      </outline>
      <outline text="保留目标/约束">
      </outline>
      <outline text="不污染主历史">
      </outline>
    </outline>
    <outline text="replace">
      <outline text="surfaceOp: replace">
      </outline>
      <outline text="sourceEventSeqs">
      </outline>
      <outline text="旧事件仍在">
      </outline>
    </outline>
  </outline>
  <outline text="s12 · Plugin kernel">
    <outline text="Plugin">
      <outline text="函数/类/对象">
      </outline>
      <outline text="贡献能力">
      </outline>
      <outline text="不占主流程">
      </outline>
    </outline>
    <outline text="Context">
      <outline text="服务键">
      </outline>
      <outline text="extend / isolate">
      </outline>
      <outline text="作用域">
      </outline>
    </outline>
    <outline text="inject / Fiber">
      <outline text="依赖未满足则等待">
      </outline>
      <outline text="effect 注册">
      </outline>
      <outline text="dispose 逆序撤销">
      </outline>
    </outline>
    <outline text="事件">
      <outline text="emit">
      </outline>
      <outline text="waterfall">
      </outline>
      <outline text="serial / bail">
      </outline>
    </outline>
  </outline>
  <outline text="s13 · 组合与启动">
    <outline text="Bundle">
      <outline text="分发插件行">
      </outline>
      <outline text="共享基础能力">
      </outline>
      <outline text="不决定机器偏好">
      </outline>
    </outline>
    <outline text="Profile">
      <outline text="产品配方">
      </outline>
      <outline text="Web / headless / 自定义">
      </outline>
      <outline text="有序装配">
      </outline>
    </outline>
    <outline text="Patch">
      <outline text="覆盖顺序">
      </outline>
      <outline text="整段替换不深合并">
      </outline>
      <outline text="!!js 逃生口">
      </outline>
    </outline>
    <outline text="Seam">
      <outline text="Definition">
      </outline>
      <outline text="Provider">
      </outline>
      <outline text="Consumer 不绕过">
      </outline>
    </outline>
  </outline>
  <outline text="s14 · 能力接缝">
    <outline text="FS">
      <outline text="read/write">
      </outline>
      <outline text="工作区边界">
      </outline>
      <outline text="provider 可替换">
      </outline>
    </outline>
    <outline text="Shell">
      <outline text="进程执行">
      </outline>
      <outline text="超时/取消">
      </outline>
      <outline text="approval">
      </outline>
    </outline>
    <outline text="Sandbox">
      <outline text="隔离级别">
      </outline>
      <outline text="fail closed">
      </outline>
      <outline text="策略解析">
      </outline>
    </outline>
    <outline text="审批">
      <outline text="风险动作">
      </outline>
      <outline text="来源/有效期">
      </outline>
      <outline text="可审计">
      </outline>
    </outline>
  </outline>
  <outline text="s15 · Subagents / presets">
    <outline text="spawn">
      <outline text="新 session">
      </outline>
      <outline text="任务 + 权限">
      </outline>
      <outline text="child id 引用">
      </outline>
    </outline>
    <outline text="预算">
      <outline text="maxDepth">
      </outline>
      <outline text="maxActive">
      </outline>
      <outline text="启动前检查">
      </outline>
    </outline>
    <outline text="preset">
      <outline text="提示词/persona">
      </outline>
      <outline text="工具子集">
      </outline>
      <outline text="按会话组装">
      </outline>
    </outline>
    <outline text="结果">
      <outline text="child 日志独立">
      </outline>
      <outline text="结果回父 inbox">
      </outline>
      <outline text="父只留摘要">
      </outline>
    </outline>
  </outline>
  <outline text="s16 · PTC">
    <outline text="program">
      <outline text="async 函数体">
      </outline>
      <outline text="顶层 await">
      </outline>
      <outline text="return 值">
      </outline>
    </outline>
    <outline text="tools.*">
      <outline text="Proxy 进入 callTool">
      </outline>
      <outline text="未知工具结构化错误">
      </outline>
      <outline text="调用记录">
      </outline>
    </outline>
    <outline text="序列化">
      <outline text="Date/Map/Set">
      </outline>
      <outline text="循环引用失败">
      </outline>
      <outline text="console 捕获">
      </outline>
    </outline>
    <outline text="边界">
      <outline text="fresh / persistent scope">
      </outline>
      <outline text="timeout">
      </outline>
      <outline text="失败是结果">
      </outline>
    </outline>
  </outline>
  <outline text="s17 · MCP / skills / commands">
    <outline text="MCP">
      <outline text="initialize">
      </outline>
      <outline text="tools/list">
      </outline>
