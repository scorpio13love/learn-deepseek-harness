# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实 key。
DEEPSEEK_API_KEY=your-deepseek-api-key

# 可选：默认 https://api.deepseek.com/anthropic（DeepSeek Messages）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# 当前 DSH 的默认模型。DeepSeek-V4.1-Flash 的 API model id 是 deepseek-flash；
# 1017 只是发布角标（release badge），不要写进 model id。
DEEPSEEK_MODEL=deepseek-flash

# 可选：单次请求最大输出 token
# DEEPSEEK_MAX_TOKENS=4096
# 可选：请求超时（毫秒）
# DEEPSEEK_TIMEOUT_MS=120000

# 可选：capstone 默认工作区（不填则复制 fixtures/project 到 outDir/workspace）
# CAPSTONE_WORKSPACE=
# 可选：产物目录
# CAPSTONE_OUT=
