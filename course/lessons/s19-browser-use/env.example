# s19 不需要任何环境变量：mock 浏览器完全离线，测试不读取 .env。
#
# 这里只列出「换成真实 provider 时」才会用到的变量，便于对照。
# 不要复制成 .env 提交；本课跑测试不需要它。

# Playwright MCP（真实 provider 时由 MCP server 自己读取）
# BROWSER_MCP_COMMAND=npx
# BROWSER_MCP_ARGS=@playwright/mcp@latest

# Chrome DevTools MCP
# CHROME_DEVTOOLS_MCP_COMMAND=npx
# CHROME_DEVTOOLS_MCP_ARGS=chrome-devtools-mcp@latest

# Stagehand 原生 provider 的上游模型（不是 DSH 模型路由）
# STAGEHAND_MODEL_API_KEY=sk-...
# STAGEHAND_MODEL=openai/gpt-4.1-mini
